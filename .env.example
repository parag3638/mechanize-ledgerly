# Copy to .env (gitignored) and fill in. Inspect reads .env automatically.

# Only model provider (DECISIONS.md D3): on-call classifier, rubric, frontier agents.
OPENAI_API_KEY=sk-replace-me

# Passphrase for references.tar.age (DECISIONS.md D4).
LEDGERLY_REFS_PASSPHRASE=replace-me

# Where Inspect writes eval logs.
INSPECT_LOG_DIR=runs/logs
RUBRIC_MODEL=gpt-5.5-2026-04-23
ONCALL_MODEL=gpt-5.5-2026-04-23
