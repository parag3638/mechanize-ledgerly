# Staging stack defaults. Settings (ledgerly/config.py) reads these; real env vars win.
LEDGERLY_APP_DSN=postgresql://ledgerly_app:ledgerly_app@postgres:5432/ledgerly
LEDGERLY_MIGRATOR_DSN=postgresql://ledgerly_migrator:ledgerly_migrator@postgres:5432/ledgerly
LEDGERLY_TEST_APP_DSN=postgresql://ledgerly_app:ledgerly_app@postgres:5432/ledgerly_test
LEDGERLY_TEST_MIGRATOR_DSN=postgresql://ledgerly_migrator:ledgerly_migrator@postgres:5432/ledgerly_test
LEDGERLY_REDIS_URL=redis://redis:6379/0
LEDGERLY_PROCESSOR_URL=http://processor:8000
LEDGERLY_PUBLIC_URL=http://proxy:8080
