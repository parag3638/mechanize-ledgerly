#!/usr/bin/env python3
"""ledgerlyctl: control Ledgerly services.

    ledgerlyctl status  <service>
    ledgerlyctl restart <service>
    ledgerlyctl stop    <service>
    ledgerlyctl start   <service>

Services: api1, api2, worker, postgres, redis. Actions are audited.
"""

import json
import sys
import urllib.error
import urllib.request

SERVICES = ("api1", "api2", "worker", "postgres", "redis")
ACTIONS = ("status", "restart", "stop", "start")


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[0] not in ACTIONS or argv[1] not in SERVICES:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    action, service = argv
    url = f"http://{service}:9900/{action}"
    method = "GET" if action == "status" else "POST"
    req = urllib.request.Request(url, method=method, headers={"X-Requested-By": "ledgerlyctl"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = json.load(resp)
    except urllib.error.URLError as exc:
        print(f"ledgerlyctl: {service} is not reachable: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(body, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
