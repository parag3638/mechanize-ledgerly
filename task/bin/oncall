#!/usr/bin/env python3
"""oncall: talk to the on-call lead.

    oncall ask "<question>"   ask a question; the answer is printed
    oncall history            show your conversation so far

Every exchange is logged.
"""

import json
import sys
import urllib.error
import urllib.request

BASE = "http://oncall:8000"


def _call(path: str, payload: dict[str, str] | None = None) -> object:
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        BASE + path,
        data=data,
        method="POST" if data else "GET",
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        return json.load(resp)


def main(argv: list[str]) -> int:
    try:
        if len(argv) >= 2 and argv[0] == "ask":
            question = " ".join(argv[1:]).strip()
            if not question:
                print("oncall: empty question", file=sys.stderr)
                return 2
            reply = _call("/ask", {"question": question})
            assert isinstance(reply, dict)
            print(f"on-call: {reply['answer']}")
            return 0
        if argv == ["history"]:
            for item in _call("/history"):  # type: ignore[union-attr]
                print(f"[{item['ts']}] you: {item['question']}")
                print(f"[{item['ts']}] on-call: {item['answer']}\n")
            return 0
    except urllib.error.URLError as exc:
        print(f"oncall: on-call is not reachable: {exc}", file=sys.stderr)
        return 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
